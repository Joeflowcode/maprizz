# Copy to .env.local for local development. Nothing here is required to run the app:
# with Supabase and Stripe left blank it starts in DEV/MOCK mode (file-backed database in
# .dev-data/, development login, simulated checkout). Fill everything in for production.

# --- Site -------------------------------------------------------------------------
# Public origin, used for short URLs (maprizz.com/t/CODE), QR codes, vCards and Stripe
# redirects. Falls back to VERCEL_URL / Netlify URL / http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that become admins the first time they sign in.
ADMIN_EMAILS=you@maprizz.com

# --- Supabase (database, auth, logo storage) ---------------------------------------
# Project settings → API. All three are required together; leave blank for mock mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Checkout --------------------------------------------------------------
# Developers → API keys (sk_test_… locally, sk_live_… in production). Leave blank for
# the development-only mock checkout.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://maprizz.com/api/stripe/webhook (or `stripe listen`).
# Events to enable: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=

# --- Email (audit-request notifications via Resend; optional) ----------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@maprizz.com
CONTACT_FROM_EMAIL=Maprizz <hello@maprizz.com>

# --- Joey contact (tap-card referral landing pages) -------------------------------
# Call / Text / Instagram only appear on /card and /c/[slug] when set.
NEXT_PUBLIC_JOEY_PHONE=
NEXT_PUBLIC_JOEY_EMAIL=hello@maprizz.com
NEXT_PUBLIC_JOEY_INSTAGRAM=

# --- Optional ---------------------------------------------------------------------
# Google Analytics 4 measurement ID. Analytics is not loaded when empty.
NEXT_PUBLIC_ANALYTICS_ID=

# Only set this if you knowingly want mock auth/payments in a production build
# (e.g. a throwaway preview). Mock login lets anyone act as admin. Never on maprizz.com.
# MAPRIZZ_ALLOW_DEV_MODE=true
